DATABASE_URL="postgresql://nutrigain:nutrigain@localhost:5432/nutrigain"
# Leave DATABASE_URL unset to use an embedded Postgres (PGlite) stored in ./.data/pg - fine for one machine.
# Set it to a hosted Postgres (Neon, Supabase, Railway...) for production. Add PGSSL=1 if the host requires SSL.
# PGSSL=1

# Background reminders (optional). Without these, reminders only fire while the app is open.
# Generate keys with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:you@example.com"
# A long random string. A scheduler calls POST /api/cron/reminders with "Authorization: Bearer <CRON_SECRET>" every 10-15 minutes.
# CRON_SECRET=
